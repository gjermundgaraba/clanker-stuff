{
  "name": "@clanker-extensions/codex-provider",
  "version": "0.1.0",
  "private": true,
  "description": "Replaces Pi's OpenAI Codex provider with Codex-compatible requests, transport, compaction, and durable checkpoint replay.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-extensions/tree/main/codex-provider#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-extensions/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-extensions.git",
    "directory": "codex-provider"
  },
  "files": [
    "audit-local-order.ts",
    "checkpoint.ts",
    "index.ts",
    "lifecycle.ts",
    "provider.ts",
    "renderer.ts",
    "replay.ts",
    "README.md",
    "LICENSE",
    "docs/design.md",
    "docs/context-alignment.md",
    "docs/live-canary.md",
    "docs/local-deployment.md",
    "scripts"
  ],
  "type": "module",
  "imports": {
    "#pi-constrained-sampling": "@earendil-works/pi-ai/api/constrained-sampling",
    "#pi-openai-codex": "@earendil-works/pi-ai/providers/openai-codex",
    "#pi-responses": "@earendil-works/pi-ai/api/openai-responses-shared",
    "#pi-simple-options": "@earendil-works/pi-ai/api/simple-options"
  },
  "exports": "./index.ts",
  "scripts": {
    "test:live": "node ./scripts/live-multi-compaction.ts",
    "test:live:branch": "node ./scripts/live-multi-compaction.ts --branch",
    "test:live:capabilities": "node ./scripts/live-multi-compaction.ts --capabilities",
    "test:live:fallback": "node ./scripts/live-multi-compaction.ts --fallback",
    "test:live:mid-turn": "node ./scripts/live-multi-compaction.ts --mid-turn",
    "test:live:portable": "node ./scripts/live-multi-compaction.ts --portable",
    "test:live:real": "node ./scripts/live-multi-compaction.ts --real-window",
    "test:live:soak:sse": "node ./scripts/live-multi-compaction.ts --soak --sse",
    "test:live:soak:websocket": "node ./scripts/live-multi-compaction.ts --soak --websocket",
    "test:live:threshold": "node ./scripts/live-multi-compaction.ts --threshold",
    "test:live:websocket": "node ./scripts/live-multi-compaction.ts --branch --websocket"
  },
  "devDependencies": {
    "vitest": "*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0"
  },
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
