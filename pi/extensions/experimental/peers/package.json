{
  "name": "@clanker-stuff/peers",
  "version": "0.1.0",
  "private": true,
  "description": "Lets running Pi sessions message each other by session name, waking the recipient, with a visible error for a name nobody has.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/experimental/peers#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/experimental/peers"
  },
  "files": [
    "index.ts",
    "tools.ts",
    "runtime.ts",
    "registry.ts",
    "mailbox.ts",
    "report.ts",
    "docs/usage.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clanker-stuff/pi-extension-paths": "workspace:^",
    "@clanker-stuff/pi-tool-rendering": "workspace:^",
    "@clanker-stuff/scheduled-check": "workspace:^"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
