  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/experimental/vim"
  },
  "files": [
    "index.ts",
    "runtime.ts",
    "transactions.ts",
    "core",
    "docs",
