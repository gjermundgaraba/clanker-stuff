{
  "name": "@clanker-stuff/presence",
  "version": "0.1.0",
  "private": true,
  "description": "Shows every running Pi session as working, waiting on you, or stopped, counting work parked on a wait or another session as working.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/experimental/presence#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/experimental/presence"
  },
  "bin": {
    "pi-who": "./cli.ts"
  },
  "files": [
    "index.ts",
    "tracker.ts",
    "record.ts",
    "verdict.ts",
    "report.ts",
    "cli.ts",
    "docs/usage.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clanker-stuff/pi-extension-paths": "workspace:^",
    "@clanker-stuff/pi-tool-rendering": "workspace:^",
    "@clanker-stuff/presence-protocol": "workspace:^"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
