{
  "name": "@clanker-stuff/codex-provider",
  "version": "0.1.0",
  "private": true,
  "description": "Replaces Pi's OpenAI Codex provider with Codex-compatible requests, fast mode, transport, compaction, and durable checkpoint replay.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/experimental/codex-provider#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/experimental/codex-provider"
  },
  "files": [
    "checkpoint.ts",
    "checkpoint-marker.ts",
    "collaboration.ts",
    "fast-mode.ts",
    "footer.ts",
    "index.ts",
    "lazy-provider.ts",
    "lifecycle.ts",
    "model-catalog.ts",
    "observability.ts",
    "provider.ts",
    "renderer.ts",
    "replay.ts",
    "runtime.ts",
    "skill-catalog.ts",
    "status.ts",
    "code-mode",
    "tools",
    "README.md",
    "LICENSE",
    "docs/codex-baseline.md",
    "docs/design.md",
    "docs/context-alignment.md",
    "docs/evaluation.md",
    "docs/live-canary.md",
    "docs/local-deployment.md"
  ],
  "type": "module",
  "imports": {
    "#pi-constrained-sampling": "@earendil-works/pi-ai/api/constrained-sampling",
    "#pi-openai-codex": "@earendil-works/pi-ai/providers/openai-codex",
    "#pi-responses": "@earendil-works/pi-ai/api/openai-responses-shared",
    "#pi-simple-options": "@earendil-works/pi-ai/api/simple-options"
  },
  "exports": "./index.ts",
  "scripts": {
    "eval:agents": "node ./scripts/evaluate-agents.ts",
    "eval:agents:dry": "node ./scripts/evaluate-agents.ts --dry-run",
    "eval:agents:smoke": "node ./scripts/evaluate-agents.ts --smoke",
    "eval:code-mode": "node ./evals/code-mode-ab.ts",
    "test:live": "node ./scripts/live-multi-compaction.ts",
    "test:live:branch": "node ./scripts/live-multi-compaction.ts --branch",
    "test:live:capabilities": "node ./scripts/live-multi-compaction.ts --capabilities",
    "test:live:fallback": "node ./scripts/live-multi-compaction.ts --fallback",
    "test:live:fast": "jiti ./scripts/live-fast.ts",
    "test:live:fault": "node ./scripts/live-multi-compaction.ts --stream-fault --sse",
    "test:live:mid-turn": "node ./scripts/live-multi-compaction.ts --mid-turn",
    "test:live:installed": "node ./scripts/live-installed.ts",
    "test:live:real": "node ./scripts/live-multi-compaction.ts --real-window",
    "test:live:crash": "node ./scripts/live-chaos.ts --crash",
    "test:live:marathon": "vp run test:live:soak:sse && vp run test:live:websocket && vp run test:live:mid-turn && vp run test:live:fault && vp run test:live:rpc && vp run test:live:crash",
    "test:live:rpc": "node ./scripts/live-chaos.ts --rpc",
    "test:live:soak:sse": "node ./scripts/live-multi-compaction.ts --soak --sse",
    "test:live:soak:websocket": "node ./scripts/live-multi-compaction.ts --soak --websocket",
    "test:live:threshold": "node ./scripts/live-multi-compaction.ts --threshold",
    "test:live:websocket": "node ./scripts/live-multi-compaction.ts --branch --websocket",
    "verify:provider": "vp run -w ready && vp run test:live:marathon && vp run eval:agents --repetitions 3 && vp run eval:agents --task compaction-resume && vp run eval:code-mode --runs 3"
  },
  "dependencies": {
    "@clanker-stuff/footer-protocol": "workspace:^",
    "@clanker-stuff/lazy-singleton": "workspace:^",
    "@clanker-stuff/pi-extension-paths": "workspace:^",
    "@clanker-stuff/tool-owner-protocol": "workspace:^"
  },
  "devDependencies": {
    "jiti": "2.7.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
