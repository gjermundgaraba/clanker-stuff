  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/experimental/waits"
  },
  "files": [
    "index.ts",
    "tools.ts",
    "spec.ts",
    "runtime.ts",
    "machine.ts",
    "check.ts",
    "journal.ts",
    "gate.ts",
    "report.ts",
    "render.ts",
    "widget.ts",
    "docs/usage.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clanker-stuff/pi-tool-rendering": "workspace:^",
