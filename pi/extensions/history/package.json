{
  "name": "@clanker-stuff/history",
  "version": "0.1.0",
  "private": false,
  "description": "Adds persistent prompt history with native ↑/↓ recall and Ctrl+R search to pi's editor.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/history#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/history"
  },
  "files": [
    "index.ts",
    "runtime.ts",
    "history.ts",
    "storage.ts",
    "import.ts",
    "editor.ts",
    "search.ts",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": "./index.ts",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clanker-stuff/editor": "workspace:^",
    "@clanker-stuff/pi-extension-paths": "workspace:^"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
