{
  "name": "@clanker-stuff/tools",
  "version": "0.1.0",
  "private": false,
  "description": "Adapts pi's coding tools to model-native interfaces and adds /tools for choosing active tools.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/tools#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/tools"
  },
  "files": [
    "index.ts",
    "operations.ts",
    "path.ts",
    "picker.ts",
    "patch.ts",
    "process-output.ts",
    "process.ts",
    "runtime.ts",
    "selection.ts",
    "code-mode",
    "profiles",
    "README.md",
    "LICENSE"
