{
  "name": "@clanker-stuff/mcp",
  "version": "0.1.0",
  "private": false,
  "description": "Connects selected MCP servers to pi and registers their tools.",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/pi/extensions/mcp#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "pi/extensions/mcp"
  },
  "files": [
    "LICENSE",
    "README.md",
    "bridge.ts",
    "config.ts",
    "connection.ts",
    "docs",
    "index.ts",
    "loaded-servers.ts",
    "loader.ts",
    "manager.ts",
    "oauth-store.ts",
    "oauth.ts",
    "open-browser.ts",
    "results.ts",
    "runtime.ts",
    "servers.ts",
    "interactions.ts",
    "elicitation-schema.ts",
    "capabilities.ts",
    "sampling.ts",
    "sampling-protocol.ts",
    "renderers.ts"
  ],
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./sampling-protocol": {
      "types": "./sampling-protocol.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clanker-stuff/code-mode-tools": "workspace:^",
    "@clanker-stuff/lazy-singleton": "workspace:^",
    "@clanker-stuff/pi-extension-paths": "workspace:^",
    "@clanker-stuff/pi-tool-rendering": "workspace:^",
    "@clanker-stuff/pi-user-input": "workspace:^",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/proper-lockfile": "4.1.4",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=26"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
