{
  "name": "clanker-stuff",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plannotator-review": "node ./scripts/build-plannotator-review.ts",
    "check:packages": "node ./scripts/check-package-readiness.ts",
    "check:plannotator-review": "node ./scripts/build-plannotator-review.ts --check",
    "check:readmes": "node ./scripts/check-readmes.ts",
    "check:tests": "node ./scripts/check-tests.ts",
    "eval:code-mode": "vp run @clanker-stuff/codex-provider#eval:code-mode",
    "prepare": "vp config --no-agent",
    "publish:dry-run": "node ./scripts/publish-packages.ts --dry-run",
    "publish:packages": "node ./scripts/publish-packages.ts",
    "ready": "vp check && vp run check:packages && vp run check:plannotator-review && vp run check:readmes && vp run check:tests && vp test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@oxlint/plugins": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typebox": "1.3.14",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.22.0"
}
