{
  "name": "@clanker-stuff/oxlint-config",
  "version": "0.1.0",
  "private": false,
  "description": "Shares the Ultracite and Effect Oxlint preset, its exceptions and a rule that keeps prose out of comments.",
  "keywords": [
    "effect",
    "oxlint",
    "ultracite"
  ],
  "homepage": "https://github.com/gjermundgaraba/clanker-stuff/tree/main/packages/oxlint-config#readme",
  "bugs": {
    "url": "https://github.com/gjermundgaraba/clanker-stuff/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gjermundgaraba/clanker-stuff.git",
    "directory": "packages/oxlint-config"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "access": "public"
  },
  "scripts": {
    "prepack": "vp pack src/index.ts src/plugin.ts --no-config --dts"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "ultracite": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@effect/tsgo": "^0.57.0",
    "oxlint": "^1.89.0",
    "ultracite": "^8.0.2",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": ">=26.12.0"
  }
}
